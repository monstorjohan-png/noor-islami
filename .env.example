# مفاتيح المصادقة — انسخ هذا الملف إلى ‎.env.local‎ واملأه.
#
# التطبيق يعمل كاملاً في وضع الضيف بلا أي مفتاح. هذه المفاتيح
# تُفعّل الدخول بحساب فقط.
#
# ‎.env.local‎ لا يُرفع إلى git أبداً.

# عنوان مشروع المصادقة من مزوّد الهوية
VITE_SUPABASE_URL=

# المفتاح العام — معروف للجميع بطبيعته، ويحميه أمن الصفوف
VITE_SUPABASE_ANON_KEY=

# مزامنة العلامات بين الأجهزة. اتركه فارغاً أو بصفر لإغلاقها.
VITE_SYNC=
