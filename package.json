{
  "name": "noor-islami",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "نور NOOR — تطبيق إسلامي شامل يعمل بدون إنترنت",
  "scripts": {
    "data": "node scripts/fetch-content.mjs",
    "data:verify": "node scripts/verify-content.mjs",
    "data:icons": "node scripts/make-icons.mjs",
    "check:text": "node scripts/check-encoding.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check": "node scripts/verify-content.mjs && node scripts/check-encoding.mjs",
    "test": "vitest run",
    "probe:reciters": "node scripts/probe-reciters.mjs",
    "deploy:manual": "npm run data && npm run build && npx wrangler pages deploy dist --project-name=noor-islami",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "adhan": "^4.4.3",
    "minisearch": "^7.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.9"
  }
}
